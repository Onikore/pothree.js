{
  "name": "potree",
  "private": true,
  "version": "1.8.0",
  "description": "WebGL point cloud viewer",
  "keywords": [
    "point",
    "cloud",
    "pointcloud",
    "octree",
    "entwine",
    "viewer",
    "threejs",
    "webgl",
    "browser",
    "tool"
  ],
  "main": "./build/potree/potree.js",
  "module": "./build/potree/potree.module.js",
  "scripts": {
    "start": "gulp watch",
    "build": "gulp build pack",
    "postinstall": "npm run build",
    "test": "node tests/visual/run.mjs --jobs 2 && node tests/visual/pick.mjs && node tests/visual/operations.mjs && node tests/visual/ondemand.mjs",
    "test:quick": "node tests/visual/run.mjs --gpu --group quick --jobs 2",
    "test:gpu": "node tests/visual/run.mjs --gpu --jobs 2"
  },
  "dependencies": {
    "gulp": "^4.0.2",
    "gulp-concat": "^2.6.1",
    "gulp-connect": "^5.7.0",
    "json5": "^2.1.3",
    "through": "~2.3.4"
  },
  "author": "Markus Schütz",
  "license": "BSD-2-CLAUSE",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-terser": "1.0.0",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "rollup": "4.64.5",
    "three": "0.186.1"
  },
  "peerDependencies": {
    "three": "^0.186.0"
  }
}
